# Railway provides PORT automatically. This fallback is used locally.
PORT=3001
HOST=0.0.0.0

# Comma-separated origins for a separately hosted client.
# The one-port production deployment works without changing this value.
CLIENT_ORIGINS=http://localhost:5173

# Vite development proxy target. Production always uses same-origin requests.
DEV_SERVER_URL=http://localhost:3001

# Required for account registration, login, and authenticated multiplayer.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/type_racer

# Railway's private PostgreSQL connection does not require TLS. Set true only
# when your database provider requires SSL connections.
DATABASE_SSL=false
